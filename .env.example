# Copy to .env and edit. Every setting is documented in src/pratyaksh/config.py.

# --- network ---------------------------------------------------------------
# The GPU laptop's IP on the demo hotspot/Wi-Fi (ipconfig / ifconfig). Phones and other laptops use it.
LAN_IP=192.168.1.10

# --- database (ADR-0004) -----------------------------------------------------
DATABASE_URL=mysql+pymysql://pratyaksh:pratyaksh-dev@127.0.0.1:3306/pratyaksh
MYSQL_PASSWORD=pratyaksh-dev
MYSQL_ROOT_PASSWORD=root-dev
# Quick look without MySQL:  DATABASE_URL=sqlite:///./pratyaksh.db

# --- LiveKit (ADR-0005) --------------------------------------------------------
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=ws://192.168.1.10:7880
# HTTPS=1: phones may use the microphone (iPhones only on HTTPS). scripts\windows\start.ps1 then serves
# https://<LAN_IP>:5173 with a certificate from scripts/lan_https.py, proxies the API and LiveKit through it
# (overriding LIVEKIT_PUBLIC_URL), and each phone installs https://<LAN_IP>:5173/pratyaksh-ca.crt once.
HTTPS=0
LIVEKIT_API_KEY=pratyaksh
LIVEKIT_API_SECRET=change-me-to-a-random-string-of-32-plus-chars

# --- verifier --------------------------------------------------------------------
API_PORT=8000
# Needed to decide Agent Reviews from the Console. Use a long random string.
CONSOLE_KEY=change-me-console-key
# The Voice Agent sends this on every call to the verifier, so no other laptop can post Responses
# or forge Reply Latency. Use a long random string; the agent and the API read the same .env.
AGENT_KEY=change-me-agent-key
CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173
VERIFIER_URL=http://127.0.0.1:8000

# --- speech models (GPU laptop, 6-8 GB VRAM) ----------------------------------------
SPEECH_BACKEND=local
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16  # full precision: no quantization loss on Hindi/Kannada (~1.6 GB VRAM for turbo)
SPOOF_MODEL=MelodyMachine/Deepfake-audio-detection-V2
SPOOF_FAKE_LABELS=fake,spoof,synthetic
# CPU-only laptop: WHISPER_MODEL=small  WHISPER_DEVICE=cpu  WHISPER_COMPUTE_TYPE=int8

# --- agent voice ---------------------------------------------------------------------
TTS_BACKEND=parler
PARLER_MODEL=ai4bharat/indic-parler-tts
# The default voice is Mary. Backup voice (its prompts are pre-rendered too):
# PARLER_DESCRIPTION=Anu speaks in a calm, warm and friendly voice at a moderate pace with a moderate pitch. Very clear audio, with a very close recording that has no background noise.
# No GPU / model not downloaded yet: TTS_BACKEND=tone

# --- LLM fallback for unclear Requests (ADR-0002); leave the key empty to disable --------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b

# --- Voice Agent listening (tune with the real mics) ---------------------------------
# Lower: whispers count as speech. Higher: ignores room noise.
VAD_ACTIVATION=0.35
# Pause that ends a reply.
VAD_MIN_SILENCE_S=0.8
# Time to unlock the phone and start reading a code.
CODE_LISTEN_TIMEOUT_S=15
# Pauses shorter than this do not end a code readout.
CODE_PAUSE_S=1.5

# --- privacy (ADR-0003): true only while recording Eval Run data with consent --------------
RETAIN_AUDIO=false
